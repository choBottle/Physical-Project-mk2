# MK2 엣지 노드 환경변수 — cp .env.example .env
# 이 엣지가 맡는 구역(공통 헤더 zone_id 와 같은 값)
MK2_ZONE_ID=zoneA
# 중앙 Collector OTLP gRPC 주소 — 터널(Tailscale 등) 위 중앙 서버 주소. 중앙 deploy/.env 의 MK2_EDGE_BIND 와 짝이다.
MK2_CENTRAL_OTLP=<중앙 서버 터널 주소>:4317
# 구역 LAN 쪽 입구(말단 장치가 붙는 곳) — 장치가 붙는 인터페이스 주소로 좁히는 것을 권장
MK2_EDGE_LAN_BIND=0.0.0.0
# 중앙이 페더레이션으로 당겨 가는 Prometheus 입구 — 엣지의 터널 주소
MK2_EDGE_TUNNEL_BIND=127.0.0.1
MK2_EDGE_PROMETHEUS_RETENTION=7d
