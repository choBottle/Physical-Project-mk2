# =============================================================================
# MK2 중앙 서버 배포 환경변수 — 템플릿
#
#   cp deploy/.env.example deploy/.env      # 또는: ./deploy/scripts/init-env.sh (비밀값 자동 생성)
#
# ⚠ deploy/.env 는 커밋하지 않는다(.gitignore). 이 파일(.env.example)에는 자리표시자만 둔다.
# ⚠ 비밀값은 **영숫자만** 쓴다. .env 를 읽는 파서가 셋(셸 source · compose dotenv ·
#   systemd EnvironmentFile)이고 따옴표·특수문자 해석이 서로 달라 한쪽만 다르게 읽는다.
# =============================================================================

# ── 배포 식별 ───────────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=mk2
# 백엔드 이미지 태그. 릴리스 배포는 ghcr.io/<owner>/mk2-backend:<버전> 으로 바꾼다.
MK2_BACKEND_IMAGE=mk2-backend:local

# ── 노출 정책 — "바인딩 주소가 곧 통제" ────────────────────────────────────
# 엣지·뷰어가 붙는 입구(MQTT 1883/9001 · WS 8765 · 미디어 8766 · 촬영본 8767 · OTLP 4316/4317/4318 · Kafka EDGE 9095)
# 기본 127.0.0.1 = 서버 밖에서 못 붙는다. 엣지를 붙일 때 서버의 터널 주소(예: `tailscale ip -4`)로 바꾼다.
# 0.0.0.0 은 인증 없는 입구(MQTT 익명·OTLP·Kafka 평문)를 모든 인터페이스에 여는 것이다 — 쓰지 않는다.
MK2_EDGE_BIND=127.0.0.1
# 운영자 화면·DB(Grafana · Prometheus · Loki · Tempo · MySQL · TimescaleDB) — 서버 안에서만
MK2_ADMIN_BIND=127.0.0.1

# 운영자용 호스트 포트 — 공용 서버에서 다른 서비스와 겹치면 여기서만 바꾼다.
# (엣지 입구 1883·8765~8767·4316~4318·9095 는 장치 쪽 설정과 짝이라 고정 — docs/PORTS.md)
MK2_PORT_MYSQL=7858
MK2_PORT_TSDB=7859
MK2_PORT_PROMETHEUS=7861
MK2_PORT_GRAFANA=7862
MK2_PORT_LOKI=3100
MK2_PORT_TEMPO=3200

# ── 도커 네트워크 — 대역을 고정한다 ─────────────────────────────────────────
# 고정하지 않으면 네트워크 재생성 때 대역이 밀려 DB 앱 계정의 host 제한이 조용히 깨진다.
MK2_NET_SUBNET=172.28.0.0/16
# MySQL 앱 계정 host 패턴 — 위 대역과 짝이다(MySQL 은 CIDR 대신 와일드카드를 쓴다)
MK2_DB_APP_HOST=172.28.%

# ── MySQL (감사 · 레지스트리 · 임무 실행 기록 · 촬영본 메타) ─────────────────
MYSQL_ROOT_PASSWORD=change_me_root_alnum_only
MK2_MYSQL_PASSWORD=change_me_app_alnum_only

# ── TimescaleDB (계측 시계열) ───────────────────────────────────────────────
MK2_TSDB_ROOT_PASSWORD=change_me_pg_alnum_only
MK2_TSDB_PASSWORD=change_me_app_alnum_only

# ── 백엔드 입구 토큰 (URL 쿼리 토큰 — loopback 밖 바인딩에 비어 있으면 기동 시 죽는다) ──
MK2_WS_TOKEN=change_me_ws_token
MK2_EDGE_TOKEN=change_me_edge_token
MK2_CAPTURE_TOKEN=change_me_capture_token

# ── Grafana ────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana

# ── Kafka EDGE 리스너 — 원격 엣지가 붙을 때 브로커가 알려줄 주소 ────────────
# localhost 로 두면 엣지가 접속은 되는데 "localhost 로 오라"는 답을 받아 자기 자신으로 되돌아간다.
# 엣지를 붙일 때 MK2_EDGE_BIND 와 같은 서버 터널 주소로 바꾼다.
MK2_KAFKA_EDGE_ADVERTISED=localhost

# ── 관측 보존 기간 ──────────────────────────────────────────────────────────
MK2_PROMETHEUS_RETENTION=15d
# Loki 14d · Tempo 168h 는 deploy/server/config/ 의 설정 파일에 있다.

# ── 브라우저 관측(OTLP/HTTP 4318) CORS — VZ 화면 출처 하나 추가 ───────────────
MK2_OTLP_CORS_EXTRA_ORIGIN=http://localhost:5175
