# ai/demo 환경변수 예시
# 복사해서 값만 바꾼 뒤 셸에 올린다:  cp .env.example .env && set -a && . ./.env && set +a
# (이 파일에는 실제 주소를 적지 말 것 — 실제 값은 .env 에만, .env 는 커밋하지 않는다)

# test/mqtt_stream_receiver.py — 로봇(Pi) MQTT 브로커 (WebSocket)
# 기본: ws://localhost:9001/mqtt.  --broker 를 주면 그 값이 우선한다.
MK2_MQTT_BROKER_URL=ws://<tailnet-host>:9001/mqtt
