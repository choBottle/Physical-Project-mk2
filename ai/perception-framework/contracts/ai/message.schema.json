{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://physical-project.local/contracts/ai/message.schema.json",
  "title": "AI Integration Message",
  "type": "object",
  "required": [
    "schema_version",
    "message_id",
    "source_id",
    "node_id",
    "zone_id",
    "entity_id",
    "channel",
    "timestamp",
    "sequence_id",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^2\\.[0-9]+$",
      "description": "AI 생산자는 공통 머리 2.x 를 낸다(frame_ref v2 · timestamp = 데이터 시각)."
    },
    "message_id": {
      "type": "string",
      "minLength": 1
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "node_id": {
      "type": "string",
      "minLength": 1
    },
    "zone_id": {
      "type": "string",
      "minLength": 1
    },
    "entity_id": {
      "type": "string",
      "minLength": 1
    },
    "channel": {
      "enum": [
        "detections",
        "risk_state",
        "ai_failure",
        "capability_status",
        "model_deployment_result"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "sequence_id": {
      "type": "integer",
      "minimum": 0
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "coordinate_frame": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "$ref": "https://github.com/khw18033/Physical-Project-mk2/contracts/common/message.schema.json"
    },
    {
      "oneOf": [
        {
          "properties": {
            "channel": {
              "const": "detections"
            },
            "payload": {
              "$ref": "https://physical-project.local/contracts/ai/detection-result.schema.json"
            }
          }
        },
        {
          "properties": {
            "channel": {
              "const": "risk_state"
            },
            "payload": {
              "$ref": "https://physical-project.local/contracts/ai/risk-judgment.schema.json"
            }
          }
        },
        {
          "properties": {
            "channel": {
              "const": "ai_failure"
            },
            "payload": {
              "$ref": "https://physical-project.local/contracts/ai/ai-failure.schema.json"
            }
          }
        },
        {
          "properties": {
            "channel": {
              "const": "capability_status"
            },
            "payload": {
              "$ref": "https://physical-project.local/contracts/ai/capability-status.schema.json"
            }
          }
        },
        {
          "properties": {
            "channel": {
              "const": "model_deployment_result"
            },
            "payload": {
              "$ref": "https://physical-project.local/contracts/ai/model-deployment-result.schema.json"
            }
          }
        }
      ]
    }
  ],
  "additionalProperties": false,
  "description": "AI 채널 메시지. 공통 머리는 백엔드 server/contracts/common/message.schema.json 을 그대로 따른다(allOf $ref — 사본을 두지 않는다). 이 파일은 AI 채널 어휘와 채널별 payload, AI 가 추가로 싣는 칸만 정한다."
}
