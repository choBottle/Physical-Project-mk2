# /etc/sar-drone.env — 드론 파트 서비스(sar-*)와 드론 에이전트 SAR 연동이 같이 읽는다.
# install.sh 가 처음 한 번 이 파일을 복사한다. 현장값만 고친다. 고친 뒤: sudo systemctl restart 'sar-*' drone-node
#
# @SAR_HOME@ 은 자리표시다 — install.sh 가 복사할 때 서비스 계정(SAR_USER, 기본 physical)의 홈으로 바꿔 넣는다
# (예: /home/<user>). 손으로 복사했으면 직접 절대경로로 바꾼다. systemd 의 EnvironmentFile 은 변수를 펼치지 않으므로
# 여기 값은 모두 절대경로여야 한다. 이미 깔린 /etc/sar-drone.env 는 install.sh 가 건드리지 않는다.

# 파이썬 venv — drone-node(HW)가 쓰는 것과 같아야 에이전트 연동이 된다
SAR_VENV=@SAR_HOME@/venv

# 장비 · 구역 (토픽 zoneA/drone/<id>/…)
SAR_DEVICE=x500-001
SAR_ZONE=zoneA

# MQTT 브로커 host:port — 화면이 붙는 브로커 (보통 노트북 또는 엣지)
SAR_MQTT=192.168.50.244:1883

# mavlink-router 끝점
SAR_FC_TCP=tcp:127.0.0.1:5760
SAR_FC_URL=udpin://0.0.0.0:14540
SAR_ULOG_URL=tcp://127.0.0.1:5760

# 비행 기록 · 레이더 · 캡처 신호
SAR_LOG_DIR=@SAR_HOME@/sar_logs
SAR_RADAR_DIR=@SAR_HOME@/cansar_data
SAR_RADAR_GLOB=**/*
SAR_CAP_PATH=@SAR_HOME@/CAP_ON
# 레이더(cansar)가 CAP_ACK 를 쓰면 경로를 넣는다. 비우면 끔
SAR_CAP_ACK=

# RTK 보정 — 노트북 base_sender 가 보내는 UDP 포트
SAR_RTCM_PORT=14660

# 데이터 서버 (화면 「비행 데이터」 · 노트북 미러가 붙는다)
SAR_DATA_PORT=8765
