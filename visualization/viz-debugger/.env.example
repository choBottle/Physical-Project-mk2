# viz-debugger 환경변수 예시 — 이 파일을 `.env.local` 로 복사해 값을 채운다(`.env.local` 은 커밋되지 않는다).
#
#   cp .env.example .env.local
#
# 모든 값은 **기본값일 뿐**이다. 화면의 「연결 관리」에서 넣은 값이 언제나 이긴다(브라우저에 저장).
# 비워 두면 그 칸은 빈 채로 뜨고(또는 로컬 기본값), 테일넷 프리셋 줄은 목록에 안 생긴다 — 「직접 입력」으로 넣는다.
# 값을 바꾼 뒤에는 개발 서버(npm run dev)를 다시 띄우거나 다시 빌드한다(Vite 가 시작 · 빌드 때 읽는다).
#
# 자리표시: <tailnet-host> = Tailscale MagicDNS 이름(예: 기계이름.<tailnet>.ts.net), <tailscale-ip> = 100.x 테일넷 IP,
#           <server-ip> = 서버의 주소(공인 또는 사설).

# ── 관제 게이트웨이 (gateway/server.ts) ───────────────────────────────────────
# VITE_GATEWAY_WS=ws://127.0.0.1:8765/state
# VITE_GATEWAY_HTTP=http://127.0.0.1:8765

# ── 로봇 브로커 (MQTT over WebSocket) ────────────────────────────────────────
# 연결 관리의 「네트워크 환경」 프리셋 — 값이 있을 때만 줄이 생긴다
VITE_PHYSICAL_PRESET_GO1=
#   예: ws://<go1-tailnet-host>:9001/mqtt
VITE_PHYSICAL_PRESET_DRONE=
#   예: ws://<drone-tailnet-host>:9001
# 처음 뜰 때의 로봇 브로커 주소(여러 줄 가능). 비우면 VITE_PHYSICAL_PRESET_GO1 과 같다
# VITE_PHYSICAL_WS=
# 자율주행 편 중계(pi1) 브로커. 예: ws://<pi1-tailnet-host>:9001/mqtt
VITE_AUTODRIVE_WS=

# ── 문 찾기 탐지 서비스 (detect_api_server.py, 포트 8000) ─────────────────────
VITE_DETECT_PRESET_TAILNET=
#   예: http://<tailnet-host>:8000
VITE_DETECT_PRESET_TAILNET_IP=
#   예: http://<tailscale-ip>:8000
# 처음 뜰 때의 주소. 비우면 VITE_DETECT_PRESET_TAILNET 과 같다. 같은 PC 면 http://127.0.0.1:8000
# VITE_DETECT_URL=

# ── 장애물 탐지 AI 서버 (자율주행 편 영상 · 장애물) ──────────────────────────
VITE_AUTODRIVE_AI_GO1=
#   예: http://<server-ip>:7864
VITE_AUTODRIVE_AI_DRONE=
#   예: http://<tailscale-ip>:8891
# 처음 뜰 때의 목록(줄바꿈으로 여럿). 비우면 위 둘(값이 있는 것만, Go1 먼저)
# VITE_AUTODRIVE_AI_BASE=

# ── 객체 탐지 추론 스트림 서버 ──────────────────────────────────────────────
# IP 칸. 예: http://<tailscale-ip>
VITE_VISION_STREAM_HOST=
# 포트 줄(줄바꿈으로 여럿). 비우면 10001~10004
# VITE_VISION_STREAM_PORTS=

# ── 3D 가상환경 화면 ─────────────────────────────────────────────────────────
# 예: http://<tailscale-ip>:8080/
VITE_VIRTUAL_3D_BASE=

# ── 그 밖의 서비스 (비우면 로컬 기본값) ──────────────────────────────────────
# VITE_STT_URL=http://127.0.0.1:8801
# VITE_GENERATE_URL=http://127.0.0.1:8802
# VITE_CAPABILITY_URL=
# VITE_MEDIA_WS=
