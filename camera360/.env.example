# camera360 환경변수 예시
# 복사해서 값만 바꾼 뒤 셸에 올린다:  cp .env.example .env && set -a && . ./.env && set +a
# 어떤 값도 안 주면 전부 localhost / 스크립트 폴더 기준 경로로 동작한다.
# (이 파일에는 실제 주소를 적지 말 것 — 실제 값은 .env 에만, .env 는 커밋하지 않는다)

# ── 중앙 서버 (pano_receiver.py :7866, 데이터 스트림 :10001) ──────────────
# stream_to_server.py · v2/stream_to_server.py · anchor360_bridge.py · pro2_auto_bg.py
MK2_SERVER_HOST=<server-ip>

# 필요할 때만: URL 전체를 직접 지정 (MK2_SERVER_HOST 보다 우선)
# MK2_UPLOAD_URL=http://<server-ip>:7866/upload_pano            # stream_to_server.py 첫 번째 업로드, pro2_auto_bg.py
# MK2_UPLOAD_STREAM_URL=http://<server-ip>:10001/upload_pano    # stream_to_server.py 두 번째 업로드
# MK2_ANCHOR360_URL=http://<server-ip>:7866/anchor360_latest    # anchor360_bridge.py --server 기본값

# ── unidepth_dual_yolo.py (기존 변수명 그대로) ───────────────────────────
# config 파일 경로. 기본: 스크립트와 같은 폴더의 unidepth_dual_yolo_config.yaml
# CONFIG_PATH=~/capstone-db/image_server/unidepth_dual_yolo_config.yaml
# Go1 제어 명령 엔드포인트. 기본: http://127.0.0.1:7864/command/go1
# CONTROL_URL=http://<server-ip>:7864/command/go1
# Redis 비밀번호 (config 의 redis.password 보다 우선). 비밀값 — 실제 값은 .env 에만
# MK2_REDIS_PASSWORD=change_me

# ── venv_image_requirements.txt ───────────────────────────────────────────
# capstone-db 체크아웃 루트 (editable 설치 경로 ${MK2_CAPSTONE_DB}/external/... 에 쓰임)
# MK2_CAPSTONE_DB=~/capstone-db
